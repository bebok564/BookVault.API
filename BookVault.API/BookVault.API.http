@host = http://localhost:5161

### Categories ###########################################################

# POST /api/categories — dodaj nową kategorię
POST {{host}}/api/categories
Content-Type: application/json

{
    "name": "Fiction"
}

###

# GET /api/categories — lista wszystkich kategorii
GET {{host}}/api/categories

###

# GET /api/categories/{id}/books — książki w danej kategorii
GET {{host}}/api/categories/1/books

### Authors ##############################################################

# POST /api/authors — dodaj autora
POST {{host}}/api/authors
Content-Type: application/json

{
    "firstName": "F. Scott",
    "lastName": "Fitzgerald",
    "bio": "American novelist",
    "birthDate": "1896-09-24"
}
 
###

# GET /api/authors — lista autorów
GET {{host}}/api/authors

###

# GET /api/authors/{id} — szczegóły autora z książkami
GET {{host}}/api/authors/1

###

# PUT /api/authors/{id} — edytuj autora
PUT {{host}}/api/authors/1
Content-Type: application/json

{
    "firstName": "Francis Scott",
    "lastName": "Fitzgerald",
    "bio": "American novelist and short story writer",
    "birthDate": "1896-09-24"
}

###

# DELETE /api/authors/{id} — usuń (tylko jeśli nie ma książek)
DELETE {{host}}/api/authors/1

### Books ################################################################

# POST /api/books — dodaj książkę (relacja many-to-many z kategoriami)
POST {{host}}/api/books
Content-Type: application/json

{
    "title": "The Great Gatsby",
    "isbn": "9780743273565",
    "description": "A novel about the American Dream",
    "pageCount": 180,
    "publishedDate": "1925-04-10",
    "authorId": 1,
    "categoryIds": [1]
}

###

# GET /api/books — lista z paginacją, filtrowaniem i sortowaniem
GET {{host}}/api/books?page=1&pageSize=10&search=Gatsby&sortBy=title

###

# GET /api/books/{id} — szczegóły z autorem, kategoriami i recenzjami
GET {{host}}/api/books/1

###

# PUT /api/books/{id} — aktualizuj książkę
PUT {{host}}/api/books/1
Content-Type: application/json

{
    "title": "The Great Gatsby",
    "isbn": "9780743273565",
    "description": "A novel about the American Dream",
    "pageCount": 200,
    "publishedDate": "1925-04-10",
    "authorId": 1,
    "categoryIds": [1]
}

###

# POST /api/books/{id}/reviews — dodaj recenzję i przelicz średnią
POST {{host}}/api/books/1/reviews
Content-Type: application/json

{
    "rating": 5,
    "comment": "I like that",
    "reviewerName": "Bebok"
}

###

# GET /api/books/{id}/reviews — lista recenzji danej książki
GET {{host}}/api/books/1/reviews

###

# DELETE /api/books/{id} — usuń książkę
DELETE {{host}}/api/books/1

###